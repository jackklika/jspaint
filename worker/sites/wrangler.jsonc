{
	// jspaint-sites: the sandbox. Serves ~name pages from R2 and nothing else (docs/DESIGN.md §9).
	// Deliberately weak: read-only bucket access, one Durable Object for <x-*> state, no secrets.
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "jspaint-sites",
	"main": "index.js",
	"compatibility_date": "2026-09-08",
	"workers_dev": true, // kept as a fallback; the Worker 301s requests from it to SITES_URL
	"preview_urls": false,
	"observability": { "enabled": true },
	// The domain itself: the root site at /, ~name sites at /~name/. Apex first (`wrangler dev` takes routes[0] as the
	// local host); www and the former sites. subdomain redirect to it (index.js legacy_host_redirect).
	"routes": [
		{ "pattern": "coolpaint.world", "custom_domain": true },
		{ "pattern": "www.coolpaint.world", "custom_domain": true },
		{ "pattern": "sites.coolpaint.world", "custom_domain": true }
	],
	"r2_buckets": [
		{ "binding": "SITES", "bucket_name": "jspaint-sites" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "SITE_STATE", "class_name": "SiteState" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SiteState"] }
	],
	// Rate limits (worker/shared/limits.js, MALICIOUS_ACTOR_PLAN.md): per address for the public JSON routes, per site
	// for the editor's "published" ping. Periods are 10 or 60 seconds; namespace ids are just unique numbers.
	"ratelimits": [
		{ "name": "LIMIT_IP_10S", "namespace_id": "2001", "simple": { "limit": 60, "period": 10 } },
		{ "name": "LIMIT_PUBLISHED", "namespace_id": "2002", "simple": { "limit": 30, "period": 10 } }
	],
	"vars": {
		"EDITOR_URL": "https://edit.coolpaint.world",
		"SITES_URL": "https://coolpaint.world"
	}
}
