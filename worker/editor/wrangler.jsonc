{
	// jspaint-editor: the Paint app (static assets built into ./dist by build-editor.mjs) plus the API that
	// writes sites into R2, and the PageRoom Durable Objects (live editing rooms, one per page).
	// Separate origin from jspaint-sites on purpose (docs/DESIGN.md §9).
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "jspaint-editor",
	"main": "index.js",
	"compatibility_date": "2026-09-08",
	"workers_dev": true, // kept as a fallback; the Worker 301s page loads from it to EDITOR_URL
	"preview_urls": false,
	"observability": { "enabled": true },
	// Custom Domains (the zone coolpaint.world is on this account): DNS records and certificates are created on deploy.
	"routes": [
		{ "pattern": "coolpaint.world", "custom_domain": true },
		{ "pattern": "www.coolpaint.world", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The Worker sees the API and the page shell (so the shell can 301 to the domain); every other asset is served directly.
		"run_worker_first": ["/api/*", "/", "/index.html"]
	},
	"r2_buckets": [
		{ "binding": "SITES", "bucket_name": "jspaint-sites" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "PAGE_ROOM", "class_name": "PageRoom" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["PageRoom"] }
	],
	"vars": {
		"EDITOR_URL": "https://coolpaint.world",
		"SITES_URL": "https://sites.coolpaint.world"
	}
	// Secret (not in config): SITE_EDIT_SECRET — `wrangler secret put SITE_EDIT_SECRET -c editor/wrangler.jsonc`.
	// Locally: editor/.dev.vars with SITE_EDIT_SECRET=...
}
