{
	// jspaint-editor: the Paint app (static assets built into ./dist by build-editor.mjs) plus the API that
	// writes sites into R2, and the PageRoom Durable Objects (live editing rooms, one per page).
	// Separate origin from jspaint-sites on purpose (docs/DESIGN.md §9).
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "jspaint-editor",
	"main": "index.js",
	"compatibility_date": "2026-09-08",
	"workers_dev": true, // kept as a fallback; the Worker 301s page loads from it to EDITOR_URL
	"preview_urls": false,
	"observability": { "enabled": true },
	// Custom Domains (the zone coolpaint.world is on this account): DNS records and certificates are created on deploy.
	// The editor is edit.coolpaint.world only. The apex and www belong to the sites Worker — a hostname must never be
	// listed in both configs: wrangler treats this list as the Worker's complete set of Custom Domains and, without a
	// TTY, silently re-points a hostname that another Worker holds.
	"routes": [
		{ "pattern": "edit.coolpaint.world", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The Worker sees every request: page addresses (/~name/page, /about) redirect into Paint, the shell can 301 to the
		// domain, and Paint's own files fall through to the assets (index.js site_entry_redirect).
		"run_worker_first": true
	},
	"r2_buckets": [
		{ "binding": "SITES", "bucket_name": "jspaint-sites" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "PAGE_ROOM", "class_name": "PageRoom" },
			{ "name": "GIF_STATS", "class_name": "GifStats" },
			{ "name": "ACCOUNTS", "class_name": "Accounts" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["PageRoom"] },
		{ "tag": "v2", "new_sqlite_classes": ["GifStats"] },
		{ "tag": "v3", "new_sqlite_classes": ["Accounts"] }
	],
	"vars": {
		"EDITOR_URL": "https://edit.coolpaint.world",
		"SITES_URL": "https://coolpaint.world",
		// Sign in with Google (auth.js): the OAuth client's ID (public); its secret is GOOGLE_CLIENT_SECRET (a Worker
		// secret). Empty = the button doesn't show. Made in the Google Cloud console (project coolpaintworld):
		// OAuth consent screen (external, scopes openid/email/profile), then a Web application client with the
		// redirect URI https://edit.coolpaint.world/auth/google/callback. See docs/DEPLOY.md.
		"GOOGLE_CLIENT_ID": "417076939978-dr3j0nbdubj42ool8prtqq5h8umhm9ra.apps.googleusercontent.com"
	}
	// Secret (not in config): SITE_EDIT_SECRET (the master key) — `wrangler secret put SITE_EDIT_SECRET -c editor/wrangler.jsonc`.
	// Site passwords are minted with it: `npm run site-password <site>` (writes editor/.passwords/<site>.txt, gitignored).
	// Optional secret: POSTHOG_API_KEY (a PostHog client key, phc_…) — injects editor-app analytics
	// (worker/shared/analytics.js; published pages on the sites Worker never carry trackers).
	// POSTHOG_HOST likewise, for non-US clouds (e.g. https://eu.i.posthog.com).
	// Locally: editor/.dev.vars with SITE_EDIT_SECRET=...
}
